{
  "name": "nexo-assist",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/agent"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:agent": "npm run dev --workspace apps/agent",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test:agent": "npm run test --workspace apps/agent",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"apps/web/src/**/*.{ts,tsx,css}\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
