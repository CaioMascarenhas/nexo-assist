# Copie com scripts/setup-deploy.py. O arquivo .env real não entra no Git.
IMAGE_REPOSITORY=ghcr.io/caiomascarenhas/nexo-assist
IMAGE_TAG=latest
PUBLIC_ORIGIN=https://nexoassist.duckdns.org
PROXY_NETWORK=proxy
POSTGRES_PASSWORD=replace-with-a-generated-database-password
INTERNAL_AGENT_SECRET=replace-with-a-generated-internal-secret
# stub não consome o modelo; live exige uma chave válida no serviço do agente.
LLM_MODE=stub
GOOGLE_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
SERVICE_DESK_TIMEZONE=America/Fortaleza
