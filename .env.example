# Copy to .env. Replace the internal secret before running.
POSTGRES_PASSWORD=nexo-local-only
INTERNAL_AGENT_SECRET=replace-with-a-random-secret-at-least-32-characters
# stub is deterministic and visibly labeled. live requires a Google API key.
LLM_MODE=stub
GOOGLE_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
SERVICE_DESK_TIMEZONE=America/Fortaleza
TICKET_FAILURE_MODE=off
